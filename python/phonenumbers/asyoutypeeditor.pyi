from re import Pattern
from typing import Iterable, Optional, Sequence, Tuple, Union

from .asyoutypeformatter import AsYouTypeFormatter
from .phonenumber import PhoneNumber

_EXTN_FRAGMENT_PATTERN: Pattern[str]
_MAX_IDD_EXPANSIONS: int
_MAX_IDD_LENGTH: int

class InputState:
    EMPTY: InputState
    INCOMPLETE: InputState
    COMPLETE: InputState

class DeletedCharKind:
    USER_DIGIT: DeletedCharKind
    USER_FORMATTING: DeletedCharKind
    AUTO_FORMATTING: DeletedCharKind

class DeletedChar:
    char: str
    position: int
    kind: DeletedCharKind
    def __init__(self, char: str, position: int, kind: DeletedCharKind) -> None: ...
    @property
    def is_digit(self) -> bool: ...
    @property
    def is_formatting(self) -> bool: ...
    @property
    def is_user_entered(self) -> bool: ...

class EditResult:
    display: str
    raw_input: str
    state: InputState
    region_code: str
    deleted: Optional[DeletedChar]
    def __init__(self, display: str, raw_input: str, state: InputState,
                 region_code: str, deleted: Optional[DeletedChar] = ...) -> None: ...

class _IddPatternTooComplexError(Exception): ...

def _parse_idd_atom(pattern: str, ii: int) -> Tuple[list, int]: ...
def _parse_idd_alternatives(pattern: str, ii: int) -> Tuple[list, int]: ...
def _expand_idd_pattern(pattern: str) -> list: ...
def _is_plus_sign(char: str) -> bool: ...
def _same_entered_char(display_char: str, raw_char: str) -> bool: ...
def _position_map(display: str, raw_input: str) -> list: ...

_EditEvent = Union[tuple, list, dict]

class AsYouTypeEditor:
    _region_code: str
    _raw_input: str
    _display: str
    _position_map: list
    def __init__(self, region_code: str) -> None: ...
    def _reformat(self) -> None: ...
    def _raw_index_for_display_position(self, position: int) -> int: ...
    def _make_result(self, deleted: Optional[DeletedChar] = ...) -> EditResult: ...
    def insert(self, position: int, text: str) -> EditResult: ...
    def delete(self, position: int) -> EditResult: ...
    def set_region(self, region_code: str) -> EditResult: ...
    def clear(self) -> None: ...
    def replay(self, events: Iterable[_EditEvent]) -> list: ...
    def _apply_event(self, event: _EditEvent) -> EditResult: ...
    @property
    def region_code(self) -> str: ...
    @property
    def raw_input(self) -> str: ...
    @property
    def display(self) -> str: ...
    @property
    def user_digits(self) -> str: ...
    def parse(self) -> Optional[PhoneNumber]: ...
    @property
    def state(self) -> InputState: ...
    @property
    def is_complete(self) -> bool: ...
    def _diallable_input(self) -> str: ...
    def _idd_strings(self) -> tuple: ...
    @property
    def has_incomplete_international_prefix(self) -> bool: ...
    def _national_significant_input(self) -> str: ...
    @property
    def has_leading_zero(self) -> bool: ...
    def _has_extension_fragment(self) -> bool: ...
    @property
    def has_extension(self) -> bool: ...

def replay_edit_log(region_code: str, events: Iterable[_EditEvent]) -> Tuple[AsYouTypeEditor, list]: ...
