from .numberrange import NumberRange
from .numberrules import ClassifiedRange

__all__: list[str]

CATALOG_SCHEMA_VERSION: int

class _AttributedRange:
    classified_range: ClassifiedRange
    source_id: str
    @property
    def number_range(self) -> NumberRange: ...
    @property
    def status(self) -> str: ...
    @property
    def number_type(self) -> int | None: ...
    @property
    def number_count(self) -> int: ...
    def to_dict(self) -> dict[str, object]: ...
    @classmethod
    def from_dict(cls, data: dict[str, object]) -> _AttributedRange: ...

class NumberCatalog:
    region_code: str
    def __init__(self, region_code: str) -> None: ...
    def add_source(self, source_id: str,
                   supply_endpoints: list[tuple[str, str]],
                   exclusion_endpoints: list[tuple[str, str]] | None = ...) -> None: ...
    def build(self) -> NumberCatalog: ...
    @property
    def coverage(self) -> list[NumberRange]: ...
    @property
    def valid_count(self) -> int: ...
    @property
    def review_ranges(self) -> list[_AttributedRange]: ...
    @property
    def source_stats(self) -> dict[str, dict[str, object]]: ...
    def totals(self) -> dict[str, int]: ...
    def to_dict(self) -> dict[str, object]: ...
    def save(self, path: str) -> None: ...
    @classmethod
    def from_dict(cls, data: dict[str, object]) -> NumberCatalog: ...
    @classmethod
    def load(cls, path: str) -> NumberCatalog: ...
    @classmethod
    def from_supply_doc(cls, region_code: str, document: dict[str, object]) -> NumberCatalog: ...

def _main(argv: list[str] | None = ...) -> int: ...
