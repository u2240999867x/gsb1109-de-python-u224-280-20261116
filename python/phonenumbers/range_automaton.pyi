__all__: list[str]

class RegexSyntaxError(ValueError):
    expression: str
    pos: int

class DigitRangeDFA:
    def __init__(self, pattern: str) -> None: ...
    @property
    def start_state(self) -> int: ...
    def is_accepting(self, state_id: int) -> bool: ...
    def transition(self, state_id: int, digit: str) -> int | None: ...
    def accepts(self, digits: str) -> bool: ...
    def state_for_prefix(self, digits: str) -> int | None: ...
    def classify_interval(self, length: int, lower: int, upper: int) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]: ...
